# OpenBSD PF Configuration
# Copy to .env and customize

# Output Configuration
PF_OUTPUT_FILE="/etc/pf.conf"   # Generated config output path

# Network Interfaces
PF_ISP_INTERFACE="ure0"          # WAN/ISP interface name
PF_LAN_INTERFACE="ure1"          # LAN interface name
PF_LAN_ENABLED=0                 # Enable LAN features (1=router mode, 0=single interface)

# Connection Limiting
PF_CONNLIMIT_PER_IP=100          # Max connections per IP (0=disabled, recommended: 50-200)

# State/Flag Filtering
PF_DROP_INVALID_STATE=1          # Drop invalid connection states (1=enabled, 0=disabled)
PF_DROP_NON_SYN=1                # Drop new non-SYN TCP packets (1=enabled, 0=disabled)
PF_INVALID_TCPFLAGS=1            # Drop invalid TCP flag combinations (1=enabled, 0=disabled)

# MSS Limiting
PF_LIMIT_MSS=1                   # Enforce MSS limits (1=enabled, 0=disabled)
PF_MAX_MSS=1440                  # Maximum MSS value

# UDP Flood Protection
PF_GUARD_UDP_FLOOD=1             # UDP flood protection (1=enabled, 0=disabled)
PF_UDP_RATE_LIMIT=256            # Max UDP packets/sec per IP

# Port Scanner Detection
PF_GUARD_PORT_SCANNER=1          # Detect port scans (1=enabled, 0=disabled)
PF_SCANNER_CONN_RATE=15          # New connections/sec before block
PF_SCANNER_TIMEOUT=86400         # Seconds to block scanner IPs

# Blocklist Update Configuration
PF_BLOCKLIST_CACHE_DAYS=180      # Re-download ip2asn database after N days (6 months)
PF_BLOCKLIST_INBOUND_URL="https://raw.githubusercontent.com/bitwire-it/ipblocklist/refs/heads/main/inbound.txt"
PF_BLOCKLIST_OUTBOUND_URL="https://raw.githubusercontent.com/bitwire-it/ipblocklist/refs/heads/main/outbound.txt"
PF_IP2ASN_URL="https://iptoasn.com/data/ip2asn-v4.tsv.gz"

# Blocklist Mode Selection
PF_BLOCKLIST_MODE="ip"           # Blocklist mode: "ip" (default) or "asn"
                                  # ip: Block individual IPs, aggregate to /24 if >100k
                                  # asn: Convert IPs to ASN ranges (current behavior)

# Blocklist GitHub Repository (for apply-blocklist.sh)
PF_BLOCKLIST_REPO_URL="https://raw.githubusercontent.com/nikescar/pf/main"

# Whitelist - Never block these critical infrastructure ranges (space-separated CIDR)
# DNS: Cloudflare (1.1.1.0/24, 1.0.0.0/24), Google (8.8.8.0/24, 8.8.4.0/24), Quad9 (9.9.9.0/24), OpenDNS (208.67.222.0/24, 208.67.220.0/24)
# GitHub: 140.82.112.0/20, 143.55.64.0/20, 192.30.252.0/22, 185.199.108.0/22
PF_WHITELIST_RANGES="1.1.1.0/24 1.0.0.0/24 8.8.8.0/24 8.8.4.0/24 9.9.9.0/24 208.67.222.0/24 208.67.220.0/24 140.82.112.0/20 143.55.64.0/20 192.30.252.0/22 185.199.108.0/22"
